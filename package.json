{
  "name": "knightlogics-site",
  "private": true,
  "scripts": {
    "dev": "node scripts/sync-serve-json.js && npx serve -l 4183 --no-port-switching .",
    "dev:full": "npx vercel dev --listen 4199 --yes",
    "dev:stack": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-knight-command-stack.ps1",
    "dev:static": "npx serve -l 4183 --no-port-switching .",
    "qa:screenshots": "node scripts/qa-screenshot-matrix.js",
    "qa:hero-devices": "node scripts/qa-hero-cross-device.js --strict",
    "qa:screenshots:services": "node scripts/qa-screenshot-matrix.js --profile=knightlogics-services",
    "qa:screenshots:client-demo": "node scripts/qa-screenshot-matrix.js --profile=client-demo",
    "qa:lighthouse": "node scripts/qa-lighthouse.js",
    "qa:commercial": "node scripts/qa-commercial-browser.js",
    "stripe:sync-catalog": "node scripts/sync-knightlogics-stripe-catalog.js",
    "stripe:sync-catalog:production": "node scripts/sync-knightlogics-stripe-catalog.js --production --confirm-production",
    "pricing:sync": "node scripts/sync-package-catalog.js",
    "pricing:generate": "node scripts/generate-package-artifacts.js",
    "pricing:check": "node scripts/check-pricing-drift.js",
    "test:pricing": "node --test scripts/tests/catalog-contract.test.js scripts/tests/package-routing.test.js scripts/tests/checkout-contract.test.js scripts/tests/frontend-contract.test.js scripts/tests/pricing-known-regressions.test.js scripts/tests/structured-data.test.js",
    "test:checkout:mock": "node --test scripts/tests/checkout-contract.test.js",
    "test:checkout:stripe": "node scripts/test-checkout-packages.js --stripe-test-mode",
    "audit:routes": "node scripts/audit-site-routes.js",
    "audit:media": "node scripts/audit-commercial-media.js",
    "verify:commercial": "npm run pricing:generate && npm run pricing:check && npm run test:pricing && npm run audit:routes && npm run audit:media",
    "reviews:sync-google": "node scripts/sync-google-reviews.js",
    "test:license-cors": "node scripts/license-cors-smoke.js",
    "test:pixelforge-billing": "node scripts/pixelforge-billing-smoke.js",
    "test:pixelforge-billing:db": "node scripts/pixelforge-billing-db-smoke.js",
    "test:security-render": "node scripts/site-security-render-smoke.js",
    "test:whistle-stop-content": "node scripts/whistle-stop-content-smoke.js"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "busboy": "^1.6.0",
    "stripe": "^22.1.0"
  },
  "devDependencies": {
    "playwright": "^1.60.0"
  }
}
